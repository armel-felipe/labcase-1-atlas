FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CASE_RELEASE_HOST=0.0.0.0 \
    CASE_RELEASE_PORT=8091

WORKDIR /app
COPY release_service/ /app/release_service/
RUN mkdir -p /app/data /app/storage && chown -R 10001:10001 /app
USER 10001:10001

CMD ["python3", "-m", "release_service"]
